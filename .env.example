# All optional. Copy to .env to override.
PORT=3000
HOST=127.0.0.1
SCC_SEED=42
# Fix "today" (YYYY-MM-DD) for demos/tests. Empty = the server machine's local date.
SCC_TODAY=
# Max CSV upload size in bytes (1024..10485760)
SCC_MAX_UPLOAD_BYTES=2097152
# Public hostname of a hosted demo, accepted as Host (e.g. scc-demo.onrender.com). Empty = Render's RENDER_EXTERNAL_HOSTNAME, if set.
SCC_PUBLIC_HOST=
